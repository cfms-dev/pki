{
  "name": "cfms-pki-acme",
  "version": "0.1.0",
  "description": "Cloudflare Workers ACME (RFC 8555 + RFC 9773 ARI) server for CFMS PKI",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.13.0"
  },
  "scripts": {
    "build:cas": "node scripts/bundle-cas.mjs",
    "build:website": "node scripts/build-website.mjs",
    "build": "npm run build:cas && npm run build:llhttp && npm run build:website",
    "generate:types": "wrangler types",
    "pretypecheck": "npm run build && npm run generate:types",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "dev": "wrangler dev --types",
    "deploy": "wrangler deploy",
    "cleanup:nonces": "node scripts/cleanup-nonces.mjs",
    "migrate:account-keys": "node scripts/migrate-account-keys.mjs",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "build:llhttp": "node scripts/build-llhttp.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/check-migrations.mjs",
    "db:migrate:local": "wrangler d1 migrations apply cfms-acme-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply cfms-acme-db --remote"
  },
  "dependencies": {
    "@peculiar/x509": "^3.1.0",
    "drizzle-orm": "0.45.4",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "0.31.11",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "undici": "8.12.4",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "packageManager": "npm@12.2.2",
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "$esbuild"
    }
  }
}
